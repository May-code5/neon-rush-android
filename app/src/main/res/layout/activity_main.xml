<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05050A">

    <View
        android:id="@+id/topGlow"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@drawable/bg_top_glow"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Personaje en el centro (preview) -->
    <FrameLayout
        android:id="@+id/characterPreview"
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="80dp">

        <View
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="@drawable/character_glow"
            android:layout_gravity="center" />

        <View
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/character_body"
            android:layout_gravity="center" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/character_core"
            android:layout_gravity="center" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEON HOP"
        android:textColor="#00F5FF"
        android:textSize="42sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.12"
        android:shadowColor="#00F5FF"
        android:shadowRadius="16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp" />

    <LinearLayout
        android:id="@+id/statsBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="10dp"
        android:background="#1A00F5FF"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp">

        <TextView
            android:id="@+id/tvHighScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Récord: 0"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:background="#44FFFFFF" />

        <TextView
            android:id="@+id/tvCoins"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 🪙"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:gravity="center" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlay"
        android:layout_width="260dp"
        android:layout_height="68dp"
        android:text="JUGAR"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:backgroundTint="#00F5FF"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toTopOf="@id/secondaryButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/secondaryButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/adBannerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShop"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:text="TIENDA"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#FF6D00"
            app:cornerRadius="10dp"
            android:layout_marginEnd="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkins"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:text="SKINS"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#B026FF"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/adBannerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
