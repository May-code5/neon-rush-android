<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05050A">

    <!-- Fondo decorativo superior -->
    <View
        android:id="@+id/topGlow"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_top_glow"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Título -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEON HOP"
        android:textColor="#00F5FF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.15"
        android:shadowColor="#00F5FF"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="18"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="70dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ENDLESS JUMP"
        android:textColor="#FF00E5"
        android:textSize="13sp"
        android:letterSpacing="0.3"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <!-- Stats bar -->
    <LinearLayout
        android:id="@+id/statsBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:background="#1A00F5FF"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="28dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp">

        <TextView
            android:id="@+id/tvHighScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Récord: 0"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:gravity="center" />

        <View
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:background="#44FFFFFF" />

        <TextView
            android:id="@+id/tvCoins"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 🪙"
            android:textColor="#FFD700"
            android:textSize="15sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Botón JUGAR grande estilo FF -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlay"
        android:layout_width="280dp"
        android:layout_height="72dp"
        android:text="JUGAR"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:backgroundTint="#00F5FF"
        app:cornerRadius="16dp"
        app:elevation="12dp"
        app:layout_constraintTop_toBottomOf="@id/statsBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp" />

    <!-- Botones secundarios -->
    <LinearLayout
        android:id="@+id/secondaryButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/btnPlay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShop"
            android:layout_width="130dp"
            android:layout_height="52dp"
            android:text="TIENDA"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#FF6D00"
            app:cornerRadius="12dp"
            android:layout_marginEnd="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkins"
            android:layout_width="130dp"
            android:layout_height="52dp"
            android:text="SKINS"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#B026FF"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Banner ads -->
    <FrameLayout
        android:id="@+id/adBannerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
