<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05050A">

    <View
        android:id="@+id/topGlow"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@drawable/bg_top_glow"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Personaje -->
    <FrameLayout
        android:id="@+id/characterPreview"
        android:layout_width="130dp"
        android:layout_height="130dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="100dp">

        <View
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:background="@drawable/character_glow"
            android:layout_gravity="center" />
        <View
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/character_body"
            android:layout_gravity="center" />
        <View
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/character_core"
            android:layout_gravity="center" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEON HOP"
        android:textColor="#00F5FF"
        android:textSize="40sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.1"
        android:shadowColor="#00F5FF"
        android:shadowRadius="14"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

    <LinearLayout
        android:id="@+id/statsBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="10dp"
        android:background="#1A00F5FF"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp">

        <TextView
            android:id="@+id/tvHighScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Récord: 0"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:background="#44FFFFFF" />

        <TextView
            android:id="@+id/tvCoins"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 🪙"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Botón principal -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlay"
        android:layout_width="250dp"
        android:layout_height="64dp"
        android:text="JUGAR"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:backgroundTint="#00F5FF"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toTopOf="@id/rowButtons1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="14dp" />

    <!-- Fila 1: Tienda + Skins -->
    <LinearLayout
        android:id="@+id/rowButtons1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/rowButtons2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShop"
            android:layout_width="115dp"
            android:layout_height="46dp"
            android:text="TIENDA"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#FF6D00"
            app:cornerRadius="10dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkins"
            android:layout_width="115dp"
            android:layout_height="46dp"
            android:text="SKINS"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#B026FF"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- Fila 2: Fondo + Música + Ajustes -->
    <LinearLayout
        android:id="@+id/rowButtons2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/adBannerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="18dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackground"
            android:layout_width="100dp"
            android:layout_height="42dp"
            android:text="FONDO"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#1A6BFF"
            app:cornerRadius="8dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMusic"
            android:layout_width="100dp"
            android:layout_height="42dp"
            android:text="MÚSICA"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#E91E63"
            app:cornerRadius="8dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            android:layout_width="100dp"
            android:layout_height="42dp"
            android:text="AJUSTES"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#455A64"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/adBannerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
