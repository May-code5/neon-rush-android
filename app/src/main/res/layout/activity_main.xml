<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05050A">

    <!-- Glow superior -->
    <View
        android:id="@+id/topGlow"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/bg_top_glow"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Título -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEON HOP"
        android:textColor="#00F5FF"
        android:textSize="44sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.14"
        android:shadowColor="#00F5FF"
        android:shadowRadius="20"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="36dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ENDLESS JUMP"
        android:textColor="#FF00E5"
        android:textSize="12sp"
        android:letterSpacing="0.35"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="2dp" />

    <!-- Stats -->
    <LinearLayout
        android:id="@+id/statsBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_stats_bar"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp">

        <TextView
            android:id="@+id/tvHighScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Récord: 0"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:background="#55FFFFFF" />

        <TextView
            android:id="@+id/tvCoins"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 🪙"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Personaje central -->
    <FrameLayout
        android:id="@+id/characterPreview"
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:layout_constraintTop_toBottomOf="@id/statsBar"
        app:layout_constraintBottom_toTopOf="@id/btnPlay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="@drawable/character_glow"
            android:layout_gravity="center" />
        <View
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/character_body"
            android:layout_gravity="center" />
        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/character_core"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Botón JUGAR -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlay"
        android:layout_width="260dp"
        android:layout_height="68dp"
        android:text="JUGAR"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:backgroundTint="#00F5FF"
        app:cornerRadius="16dp"
        app:elevation="10dp"
        app:layout_constraintBottom_toTopOf="@id/rowButtons1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <!-- Fila Tienda + Skins -->
    <LinearLayout
        android:id="@+id/rowButtons1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/rowButtons2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShop"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:text="TIENDA"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#FF6D00"
            app:cornerRadius="12dp"
            android:layout_marginEnd="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkins"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:text="SKINS"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#B026FF"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Fila Fondo + Música + Ajustes -->
    <LinearLayout
        android:id="@+id/rowButtons2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/adBannerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackground"
            android:layout_width="100dp"
            android:layout_height="42dp"
            android:text="FONDO"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#1A6BFF"
            app:cornerRadius="10dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMusic"
            android:layout_width="100dp"
            android:layout_height="42dp"
            android:text="MÚSICA"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#E91E63"
            app:cornerRadius="10dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            android:layout_width="100dp"
            android:layout_height="42dp"
            android:text="AJUSTES"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#455A64"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/adBannerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
