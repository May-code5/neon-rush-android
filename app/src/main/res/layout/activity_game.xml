<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darker_bg">

    <!-- El GameView se añade programáticamente -->

    <LinearLayout
        android:id="@+id/hudLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Puntos: 0"
            android:textColor="@color/neon_cyan"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGameCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 🪙"
            android:textColor="@color/neon_yellow"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Overlay de Game Over -->
    <LinearLayout
        android:id="@+id/gameOverOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC000000"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_over"
            android:textColor="@color/neon_pink"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFinalScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Puntos: 0"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:layout_marginTop="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRevive"
            android:layout_width="220dp"
            android:layout_height="56dp"
            android:text="@string/revive"
            android:layout_marginTop="32dp"
            app:backgroundTint="@color/neon_purple"
            app:cornerRadius="28dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenu"
            android:layout_width="220dp"
            android:layout_height="56dp"
            android:text="@string/menu"
            android:layout_marginTop="16dp"
            app:backgroundTint="@color/neon_magenta"
            app:cornerRadius="28dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>

</FrameLayout>
